{
  "name": "shoppingpal",
  "version": "1.0.0",
  "private": true,
  "description": "Shopping Pal — an agentic commerce storefront. Your pal for finding the right thing to buy.",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @shoppingpal/web dev",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @shoppingpal/web test:e2e"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "@electric-sql/pglite",
      "@tailwindcss/oxide",
      "sharp"
    ]
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.1",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "turbo": "^2.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
