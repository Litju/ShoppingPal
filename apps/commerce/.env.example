# Medusa backend
# Host port 5433 maps to the container's 5432 (avoids clashing with any
# locally installed PostgreSQL service).
DATABASE_URL=postgres://shoppingpal:shoppingpal@localhost:5433/shoppingpal
REDIS_URL=redis://localhost:6379

STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:7001
AUTH_CORS=http://localhost:3000,http://localhost:9000
JWT_SECRET=<generate-a-local-secret>
COOKIE_SECRET=<generate-a-local-secret>

# Optional payment provider. Use a test key only during local qualification.
STRIPE_API_KEY=

# Typesense sync (the service defaults are shown for local Docker)
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=
MEDUSA_REGION_ID=
