# Agent runtime
AGENT_HOST=127.0.0.1
AGENT_PORT=8200
AGENT_INTERNAL_TOKEN=<generate-a-local-token>
AGENT_ACTOR_SIGNING_SECRET=<separate-secret-for-actor-binding>
# Leave this false when the service is reachable beyond localhost.
AGENT_ALLOW_UNAUTHENTICATED_LOCAL=false

# Agent state
AGENT_DATABASE_URL=postgresql://<user>:<password>@localhost:5433/<database>
AGENT_CHECKPOINT_BACKEND=postgres

# Commerce authority
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=
MEDUSA_REGION_ID=

# Disposable discovery projection; every result is hydrated from Medusa.
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=
