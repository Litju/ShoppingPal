{
  "name": "@shoppingpal/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared ShoppingPal contracts: money math, cart DTOs, deterministic ids, catalog dataset. Pure TypeScript, zero runtime dependencies.",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"covered by consuming workspaces\" && exit 0"
  },
  "devDependencies": {
    "@shoppingpal/config": "workspace:*",
    "@types/node": "^26.2.0",
    "typescript": "~5.9.3"
  }
}
