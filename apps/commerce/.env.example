# Medusa backend
# Host port 5433 maps to the container's 5432 (avoids clashing with any
# locally installed PostgreSQL service).
DATABASE_URL=postgres://shoppingpal:shoppingpal@localhost:5433/shoppingpal
REDIS_URL=redis://localhost:6379

STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:7001
AUTH_CORS=http://localhost:3000,http://localhost:9000
JWT_SECRET=replace-me
COOKIE_SECRET=replace-me

# Optional: enables the Stripe payment provider module
# STRIPE_API_KEY=sk_test_...
