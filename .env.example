# ShoppingPal local configuration reference
#
# Copy only the entries needed by the service you are running. Blank
# credential values are intentional; never commit real secrets.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=

# Medusa commerce
MEDUSA_BACKEND_URL=
MEDUSA_PUBLISHABLE_KEY=
MEDUSA_REGION_ID=
JWT_SECRET=
COOKIE_SECRET=

# Redis
REDIS_URL=redis://localhost:6379

# Typesense discovery
SEARCH_BACKEND=catalog
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=

# Eve agent runtime
AGENT_URL=
AGENT_INTERNAL_TOKEN=
AGENT_DATABASE_URL=
AGENT_CHECKPOINT_BACKEND=memory
AGENT_HOST=127.0.0.1
AGENT_PORT=8200
AGENT_ALLOW_UNAUTHENTICATED_LOCAL=false

# Official Eve model routing through Vercel AI Gateway
AI_GATEWAY_API_KEY=
SHOPPINGPAL_AGENT_MODEL=nvidia/nemotron-3.5-lightning-free

# Medusa payment provider (test mode only during qualification)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CAPTURE=true
NEXT_PUBLIC_STRIPE_PK=

# Observability
# The local runtime has no required external observability credentials.
