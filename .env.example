# ShoppingPal local configuration reference
#
# Copy only the entries needed by the service you are running. Blank
# credential values are intentional; never commit real secrets.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=

# Medusa commerce
MEDUSA_BACKEND_URL=
MEDUSA_PUBLISHABLE_KEY=
MEDUSA_REGION_ID=

# Redis
REDIS_URL=redis://localhost:6379

# Typesense discovery
SEARCH_BACKEND=catalog
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=

# Eve agent runtime
AGENT_URL=
AGENT_INTERNAL_TOKEN=
AGENT_DATABASE_URL=
AGENT_CHECKPOINT_BACKEND=memory
AGENT_HOST=127.0.0.1
AGENT_PORT=8200

# Optional model gateway for the web fallback
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional Medusa payment provider (test key only)
STRIPE_API_KEY=

# Observability
# The local runtime has no required external observability credentials.
