# ──────────────────────────────────────────────────────────────────────────
# Shopping Pal configuration
#
# The app runs in a fully working DEMO MODE when every value below is left
# empty: an embedded Postgres (PGlite, stored in .data/pg) powers the catalog,
# carts, accounts and conversations; checkout uses a clearly-labeled simulated
# payment page; and the Shopping Pal agent runs a deterministic offline engine
# so the generative UI can be demonstrated without any API keys.
# ──────────────────────────────────────────────────────────────────────────

# ── Database ───────────────────────────────────────────────────────────────
# Any Postgres connection string. Use a pooled connection string for Neon.
# Leave empty to use the embedded PGlite database stored in .data/pg.
DATABASE_URL=

# ── Better Auth ────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── LLM provider (any ONE of the following) ────────────────────────────────
# The provider is auto-detected from whichever key is present.
# Optionally force a provider/model:
#   AI_PROVIDER=openai | anthropic | google
#   AI_MODEL=gpt-4o-mini | claude-sonnet-4-5 | gemini-2.5-flash | ...
AI_PROVIDER=
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Stripe (test mode keys only) ───────────────────────────────────────────
# Without these, checkout falls back to the labeled demo flow.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Better Auth ────────────────────────────────────────────────────────────
# Required for auth to work when DATABASE_URL is set. Generate with:
#   pnpm exec openssl rand -base64 32   (or any long random string)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── Google OAuth (optional) ────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
